# cp .env.docker.example .env.docker  puis  docker compose --env-file .env.docker up -d --build

# Nom de domaine servi par Traefik
APP_HOST=ip.example.org
# Réseau Docker partagé avec Traefik et nom du certresolver
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt

# Secret Symfony : openssl rand -hex 32
APP_SECRET=
# Transport SMTP (TLS recommandé), ex. smtp://user:pass@smtp.example.org:587
MAILER_DSN=
MAIL_FROM=ip-noreply@example.org
# Destinataire tant que le backoffice n'en a pas défini un
DEFAULT_RECIPIENT=crip22@example.org

# CaptchEtat (PISTE) : identifiants OAuth, scope piste.captchetat. Laisser vide pour désactiver le captcha.
CAPTCHETAT_CLIENT_ID=
CAPTCHETAT_CLIENT_SECRET=
CAPTCHETAT_ENV=prod
