{% extends 'admin/base.html.twig' %}

{% block admin_title %}Mot de passe{% endblock %}

{% block body %}
<section class="card card--narrow">
    <h1>Modifier mon mot de passe</h1>
    {{ form_start(form, {attr: {class: 'ip-form', novalidate: 'novalidate'}}) }}
        {{ form_row(form.current) }}
        {{ form_row(form.new.first) }}
        {{ form_row(form.new.second) }}
        {{ form_errors(form.new) }}
        <div class="actions"><button type="submit" class="btn btn--primary">Modifier</button></div>
    {{ form_end(form) }}
</section>
{% endblock %}
